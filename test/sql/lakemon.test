# name: test/sql/lakemon.test
# description: smoke tests for the lakemon extension
# group: [sql]

statement error
SELECT lakemon_version();
----
Catalog Error: Scalar Function with name lakemon_version does not exist!

require lakemon

query I
SELECT lakemon_version();
----
0.1.0

query I
SELECT count(*) FROM lakemon_policy();
----
4

query I
SELECT count(*) FROM lakemon_policy() WHERE kind = 'rewrite_ladder';
----
1

query I
SELECT count(*) FROM lakemon_policy() WHERE kind = 'merge_tier';
----
3

query I
SELECT name FROM lakemon_policy() WHERE kind = 'rewrite_ladder';
----
default

query I
SELECT name FROM lakemon_policy() WHERE kind = 'merge_tier' ORDER BY name;
----
medium
micro
small

query I
SELECT min_value, threshold_or_target FROM lakemon_policy() WHERE kind = 'rewrite_ladder';
----
10000	data-driven

query I
SELECT threshold_or_target FROM lakemon_policy() WHERE kind = 'merge_tier' AND name = 'micro';
----
5MB

query I
SELECT source FROM lakemon_policy() WHERE kind = 'rewrite_ladder';
----
default

# Persist does not require an attached DuckLake catalog.
query II
SELECT status, details FROM lakemon_set_policy('lake', 'rewrite_ladder', 'default', high_min => 20000);
----
ok	medium_min=1000; low_min=100; byte_budget=none; max_rewrite_steps=3

query II
SELECT min_value, source FROM lakemon_policy('lake') WHERE kind = 'rewrite_ladder';
----
20000	override

# Zero-arg form stays on built-in defaults.
query II
SELECT min_value, source FROM lakemon_policy() WHERE kind = 'rewrite_ladder';
----
10000	default

query I
SELECT notes FROM lakemon_policy('lake') WHERE kind = 'rewrite_ladder';
----
medium_min=1000; low_min=100; byte_budget=none; max_rewrite_steps=3

query II
SELECT status, details FROM lakemon_set_policy('lake', 'merge_tier', 'micro', target_file_size => '8MB', max_compacted_files => 128);
----
ok	target_file_size=8MB

query II
SELECT threshold_or_target, source FROM lakemon_policy('lake') WHERE kind = 'merge_tier' AND name = 'micro';
----
8MB	override

query I
SELECT status FROM lakemon_set_policy('lake', 'rewrite_ladder', 'default', reset => true);
----
ok

query I
SELECT source FROM lakemon_policy('lake') WHERE kind = 'rewrite_ladder';
----
default

query I
SELECT status FROM lakemon_set_policy('other', 'rewrite_ladder', 'default', low_min => 50);
----
ok

# Catalog keys are independent.
query I
SELECT source FROM lakemon_policy('lake') WHERE kind = 'rewrite_ladder';
----
default

query I
SELECT status FROM lakemon_set_policy('other', reset_all => true);
----
ok

query I
SELECT status FROM lakemon_set_policy('lake', 'rewrite_ladder', 'hot', high_min => 20000);
----
error

query I
SELECT status FROM lakemon_set_policy('lake', 'rewrite_ladder', 'default', high_min => 500);
----
error

# Session stays usable after set_policy errors.
query I
SELECT lakemon_version();
----
0.1.0

statement error
CALL lakemon_set_policy('');
----
lakemon:
